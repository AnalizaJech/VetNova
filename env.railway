# ============================================================
# .env.railway — Variables de entorno para Railway
# NO subas este archivo a GitHub.
# Copia cada variable manualmente en:
# Railway → tu proyecto → Variables
# ============================================================

APP_NAME=VetNova
APP_ENV=production
APP_DEBUG=false
# APP_KEY → Railway la genera automáticamente con: php artisan key:generate --show
APP_KEY=base64:LXU+Btqe+3CgaFdqtonZjfPQcvKA0lIDJTZYJZAYhBk=

# Railway te da esta URL automáticamente cuando haces deploy
# Ej: https://vetnova-production.up.railway.app
APP_URL=https://TU-APP.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# ── Base de datos (Railway MySQL) ──────────────────────────
# Cuando agregas el plugin MySQL en Railway, estas variables
# se completan automáticamente con ${{MySQL.MYSQL_*}}
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQL_HOST}}
DB_PORT=${{MySQL.MYSQL_PORT}}
DB_DATABASE=${{MySQL.MYSQL_DATABASE}}
DB_USERNAME=${{MySQL.MYSQL_USER}}
DB_PASSWORD=${{MySQL.MYSQL_PASSWORD}}

# ── Cache y Sesiones ───────────────────────────────────────
# En Railway usamos file para simplicidad (no necesita Redis)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ── Logs ───────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── PeruAPI ────────────────────────────────────────────────
# IMPORTANTE: Después del deploy, ve a peruapi.com y actualiza
# la IP autorizada con la IP fija que Railway te asigna.
# La IP de Railway la encuentras en: Railway → tu app → Settings → Networking
PERUAPI_KEY=02dd8e7fce0843cda4d8398eb56f0cc3
PERUAPI_BASE_URL=https://peruapi.com

# ── Nubefact (facturación electrónica) ────────────────────
NUBEFACT_TOKEN=
NUBEFACT_URL=

# ── Mail (opcional, configurar después) ───────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@vetnova.pe"
MAIL_FROM_NAME="VetNova"
